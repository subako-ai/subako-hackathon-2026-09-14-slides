{
  "name": "subako-hackathon-slides",
  "private": true,
  "scripts": {
    "dev": "marp --theme-set themes/ -s .",
    "pdf": "marp --theme-set themes/ --allow-local-files --pdf deck.md",
    "html": "marp --theme-set themes/ --allow-local-files deck.md",
    "sample": "marp --theme-set themes/ --allow-local-files --pdf sample.md",
    "site": "rm -rf site && marp --theme-set themes/ -o site/index.html deck.md && cp -R assets site/assets"
  },
  "devDependencies": {
    "@marp-team/marp-cli": "^4.1.2"
  }
}
